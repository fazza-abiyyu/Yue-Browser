{
  "manifest_version": 3,
  "name": "Web Locker",
  "version": "1.0",
  "description": "Lock specific websites with a PIN or password.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Web Locker",
    "default_icon": "image.png"
  },
  "icons": {
    "16": "image.png",
    "32": "image.png",
    "48": "image.png",
    "128": "image.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["content.css", "image.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
